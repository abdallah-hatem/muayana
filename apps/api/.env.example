# Copy to apps/api/.env for local development. Never commit the real .env.
NODE_ENV=development
# API port (plan: API 3101, web 3100; agent N uses API 31N1 / web 31N3)
PORT=3101
# Local Postgres from the root docker-compose.yml (host port 5442), database `muayana`
DATABASE_URL=postgresql://postgres:postgres@localhost:5442/muayana?schema=public
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3100
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Photo storage: `local` (disk, dev/test) or `blob` (Vercel Blob, deployed)
STORAGE_DRIVER=local
# local driver: folder (relative to apps/api) and the public URL it is served under
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:3101/uploads
# blob driver only
BLOB_READ_WRITE_TOKEN=
# The engineer account `npm run db:seed` creates if missing. Placeholders: set your own locally,
# never commit real values.
SEED_ENGINEER_EMAIL=engineer@muayana.test
SEED_ENGINEER_PASSWORD=change-me-at-least-8-chars
SEED_ENGINEER_NAME=Engineer
# Sample sites/workers/issues (local and preview only; refused with NODE_ENV=production)
SEED_ALLOW_SAMPLE=false
