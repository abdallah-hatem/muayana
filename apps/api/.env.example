# Copy to apps/api/.env for local development. Never commit the real .env.
# Deployed (Vercel project muayana-api): set these in Settings → Environment Variables for
# Production AND Preview — see docs/DEPLOY.md. Placeholders only in this file.

# development | test | production. Do NOT set it on Vercel: Vercel sets production itself, and a
# NODE_ENV=production at install time would skip the devDependencies the build needs.
NODE_ENV=development

# API port (plan: API 3101, web 3100; agent N uses API 31N1 / web 31N3). Not needed on Vercel.
PORT=3101

# Postgres the app connects to. Local: the root docker-compose.yml (host port 5442), database
# `muayana`. Vercel: set by the Neon integration — the POOLED endpoint (host contains -pooler).
# On Vercel the app keeps one connection per function instance (src/database/database.service.ts).
DATABASE_URL=postgresql://postgres:postgres@localhost:5442/muayana?schema=public

# Migrations only, never read by the running app. Vercel: set by the Neon integration — the
# direct (unpooled) endpoint. Run migrations from your PC with it:
#   DATABASE_URL="<DATABASE_URL_UNPOOLED>" npx prisma migrate deploy
# Leave empty locally.
DATABASE_URL_UNPOOLED=

# Comma-separated origins allowed by CORS. Deployed: the web app's URL(s), e.g.
# https://muayana-web.vercel.app (the browser never calls the API directly; the web server does).
CORS_ORIGINS=http://localhost:3100

# Signs the session tokens. At least 32 random characters; a different value per environment.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Photo storage: `local` (disk, dev/test) or `blob` (Vercel Blob — required when deployed: a
# Vercel function's disk does not survive). With `blob` the /uploads route is not served.
STORAGE_DRIVER=local

# local driver only: folder (relative to apps/api) and the public URL it is served under.
# Leave both unset on Vercel.
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:3101/uploads

# blob driver only: the store's read-write token. Vercel: set by
# `vercel blob create-store muayana-photos` (the store is PUBLIC on purpose — business §6.10).
BLOB_READ_WRITE_TOKEN=

# Take the client IP (the sign-in rate-limit key) from X-Forwarded-For, which the web proxy sets.
# true when deployed behind the web app, false locally.
TRUST_PROXY=false

# Read by `npm run db:seed` only (run from your PC, never set on Vercel).
# The engineer account it creates if missing. Placeholders: set your own, never commit real values.
SEED_ENGINEER_EMAIL=engineer@muayana.test
SEED_ENGINEER_PASSWORD=change-me-at-least-8-chars
SEED_ENGINEER_NAME=Engineer
# Sample sites/workers/issues (local and preview only; refused with NODE_ENV=production)
SEED_ALLOW_SAMPLE=false

# Set by Vercel on every deployment (do not set it yourself): shrinks the DB pool to one connection.
# VERCEL=1
