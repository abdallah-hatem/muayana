# e2e settings: copy to apps/api/.env.test (or export them). Points at a dedicated test database,
# never the dev one. A parallel agent sets DATABASE_URL from `npm run db:agent -- create <name>`
# and API_PORT=31N1 instead.
NODE_ENV=test
PORT=3102
DATABASE_URL=postgresql://postgres:postgres@localhost:5442/muayana_test?schema=public
CORS_ORIGINS=http://localhost:3100
# At least 32 random characters (any throwaway value)
JWT_SECRET=
STORAGE_DRIVER=local
UPLOAD_DIR=uploads-test
PUBLIC_UPLOAD_BASE_URL=http://localhost:3102/uploads
# Take the client IP from X-Forwarded-For (set by the web proxy). true when deployed, false locally.
TRUST_PROXY=false
