# Copy to apps/web/.env.local for local development.
# Deployed (Vercel project muayana-web): set it in Settings → Environment Variables for
# Production AND Preview — see docs/DEPLOY.md.

# Where the API lives, including /api/v1. Read on the server only (src/lib/env.ts): the browser
# never calls the API directly, it goes through this app's /api/proxy route.
# Deployed: the muayana-api production URL, e.g. https://muayana-api.vercel.app/api/v1
API_URL=http://localhost:3101/api/v1

# Local dev only: let a phone on the same Wi-Fi open the dev server by LAN IP (comma-separated).
# DEV_ORIGINS=192.168.1.2
