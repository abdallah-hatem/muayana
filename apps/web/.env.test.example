# Playwright settings: copy to apps/web/.env.test (or export them). No ports are hardcoded in config.
# Playwright starts `next dev` on WEB_PORT (a parallel agent uses its block: web 31N3)
WEB_PORT=3100
# Optional: the API the dev server talks to (API_URL=http://localhost:$API_PORT/api/v1)
# API_PORT=3101
# Optional: test a server that is already running instead of starting one
# BASE_URL=http://localhost:3100
# The seeded engineer the sign-in smoke uses (SEED_ENGINEER_EMAIL / SEED_ENGINEER_PASSWORD from
# apps/api/.env). Placeholders: set your own, never commit real values.
E2E_ENGINEER_EMAIL=engineer@muayana.test
E2E_ENGINEER_PASSWORD=change-me-at-least-8-chars
